rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Es administrador quien tiene rol ADMIN en usuarios/{uid}.
    // El rol solo se cambia a mano desde la consola de Firebase.
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "ADMIN";
    }

    // Catalogo: cualquier usuario con sesion lo lee; solo el administrador lo administra.
    match /productos/{id} {
      allow read: if request.auth != null;
      allow create, delete: if esAdmin();
      // Un cliente solo puede BAJAR el stock (al comprar) y ningun otro campo.
      allow update: if esAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
            && request.resource.data.stock is number
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock);
    }

    // Consulta del administrador sobre los pedidos de TODOS los usuarios (collectionGroup).
    match /{path=**}/pedidos/{id} {
      allow read: if esAdmin();
    }

    // Cada usuario solo puede ver y modificar SUS propios datos.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Al crear la cuenta el rol solo puede ser CLIENTE.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rol == "CLIENTE";

      // El rol no se puede cambiar desde la app (el admin se asigna en la consola de Firebase).
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol;

      allow delete: if false;

      match /favoritos/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /direcciones/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /metodosPago/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // Solo marca y ultimos 4 digitos; nunca el numero completo.
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && request.resource.data.ultimos4 is string
                              && request.resource.data.ultimos4.size() == 4;
      }

      // Pedidos: el cliente crea y lee los suyos (siempre como PENDIENTE).
      // Solo el administrador cambia el estado; nadie borra pedidos.
      match /pedidos/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
                 && (!('estado' in request.resource.data)
                     || request.resource.data.estado == "PENDIENTE");
        allow update: if esAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
                      && request.resource.data.estado in ['PENDIENTE', 'PREPARADO', 'ENTREGADO'];
        allow delete: if false;
      }
    }
  }
}
